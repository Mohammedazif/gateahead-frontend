{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "${API_ORIGIN}/$1",
      "env": ["API_ORIGIN"]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
