{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://gateahead-api.onrender.com/$1"
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
